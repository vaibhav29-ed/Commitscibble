{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "NODE_ENV=production pnpm install --frozen-lockfile --prod=false",
  "buildCommand": "NODE_ENV=production pnpm --filter @commitscibble/shared build && NODE_ENV=production pnpm --filter @commitscibble/web build && node scripts/verify-web-build.mjs",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://commitscibble-api-production.up.railway.app/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://commitscibble-api-production.up.railway.app/auth/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
