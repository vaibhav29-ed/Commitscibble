# ---------------------------------------------------------------------------
# CommitScibble environment configuration
# Copy to .env and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Runtime
# NODE_ENV=development is for local machines only. Never copy it into Vercel or
# Railway: a production Vite build with NODE_ENV=development ships the React dev
# bundle and resolves API calls to http://localhost:4000.
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# Persistence
MONGO_URI=mongodb://localhost:27017/commitscibble
REDIS_URL=redis://localhost:6379

# Sessions / crypto (generate with: openssl rand -base64 48 / openssl rand -base64 32)
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

# GitHub OAuth app (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_REPOSITORY_LIMIT=500

# GitHub App (optional; installation-scoped tokens for repository writes)
# Create at https://github.com/settings/apps, set the setup URL to
# <API_URL>/auth/github/app/callback and paste the private key (.pem) here.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=

# AI providers
AI_PROVIDER_PRIMARY=gemini
AI_PROVIDER_FALLBACK=groq
AI_MAX_RETRIES=2
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=8192
AI_MAX_CONCURRENCY=2
AI_MAX_CONTEXT_CHARS=90000
AI_ALLOW_MOCK=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Convex realtime activity (optional; dashboard falls back to polling)
CONVEX_URL=
COMMITSCIBBLE_PUBLISH_TOKEN=

# Documentation defaults
README_FILE_NAME=README.md
DOC_UPDATE_MODE=REVIEW
STALE_RUN_MINUTES=15
WEBHOOK_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90

# Billing (optional, isolated; disabled unless BILLING_ENABLED=true)
BILLING_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional transactional email (Resend). Set both to enable notifications.
# When either is empty, all email notifications are disabled.
RESEND_API_KEY=
EMAIL_FROM=

# Frontend (Vite) - public values only, never secrets
VITE_API_URL=http://localhost:4000
VITE_CONVEX_URL=
